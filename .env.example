NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_API_KEY=
ESP32_IP=
ESP32_COMMAND_PORT=8888
ESP32_TELEMETRY_PORT=8889
LLM_DRY_RUN=true
LLM_LINEAR_SPEED_CM_S=5.0
LLM_HEARTBEAT_S=0.10
LLM_TELEMETRY_TIMEOUT_S=0.80

# RAG-only time budgets; these do not change robot safety/watchdog timers.
DIG_KNOWLEDGE_TIMEOUT_S=90
DIG_KNOWLEDGE_RERANK_TIMEOUT_S=15
DIG_KNOWLEDGE_MAX_TOKENS=2048

# Optional retrieval/cloud features; uploads remain local without separate consent.
DIG_KNOWLEDGE_VECTOR=0
DIG_KNOWLEDGE_RERANK=0
DIG_KNOWLEDGE_CLOUD=0
